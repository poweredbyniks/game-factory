{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "themeId": "cozy_village",
  "name": "Cozy Village",
  "description": "Warm autumn village: cream paper, terracotta roofs, sage shutters, honey light.",
  "palette": {
    "primary": "#C8553D",
    "primaryDark": "#9E3F2C",
    "secondary": "#588B8B",
    "accent": "#F2A541",
    "background": "#FBF1E3",
    "backgroundAlt": "#F3DFC1",
