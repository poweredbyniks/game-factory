{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "verified"
        },
        "environment": {
          "type": "string",
          "enum": [
            "production",
            "sandbox",
            "mock"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "invalid"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "title": "PurchaseVerificationResult",
  "description": "Response of POST /v1/purchases/verify"
}
