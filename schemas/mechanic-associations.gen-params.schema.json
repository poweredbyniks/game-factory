{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "[min, max] categories per level"
    },
    "wordsPerCategory": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "columns": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7
    },
    "columnHeight": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "faceDown": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "[min, max] face-down cards per column (always below the top)"
    },
    "categoryDifficulty": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "[min, max] content difficulty 1..5"
    },
    "moveSlack": {
      "type": "object",
      "properties": {
        "factor": {
          "type": "number",
          "minimum": 1
        },
        "flat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "factor",
        "flat"
      ],
      "additionalProperties": false
    },
    "starFractions": {
      "type": "object",
      "properties": {
        "two": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "three": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "two",
        "three"
      ],
      "additionalProperties": false
    },
    "minStock": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minSolutionLength": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "default": 40,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxSolverNodes": {
      "default": 60000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rules": {
      "default": {},
      "type": "object",
      "properties": {
        "foundationSlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Category slots available at once"
        },
        "drawCount": {
          "type": "number",
          "const": 1
        },
        "recycleLimit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Stock recycles allowed; null = unlimited"
        },
        "mismatchCostsMove": {
          "type": "boolean"
        },
        "wordOnWord": {
          "type": "string",
          "enum": [
            "same_category",
            "never"
          ]
        },
        "emptyColumn": {
          "type": "string",
          "enum": [
            "any",
            "category_only",
            "none"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "categories",
    "wordsPerCategory",
    "columns",
    "columnHeight",
    "faceDown",
    "categoryDifficulty",
    "moveSlack",
    "starFractions"
  ],
  "additionalProperties": false
}
