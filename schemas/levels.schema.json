{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Schema version of this file"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "mechanic": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "difficulty": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string",
                "enum": [
                  "tutorial",
                  "easy",
                  "medium",
                  "hard",
                  "expert"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "tier",
              "score"
            ],
            "additionalProperties": false
          },
          "objectives": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "clear_board"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "lose": {
            "type": "object",
            "properties": {
              "outOfMoves": {
                "type": "boolean"
              },
              "stuck": {
                "type": "boolean"
              }
            },
            "required": [
              "outOfMoves",
              "stuck"
            ],
            "additionalProperties": false
          },
          "boosters": {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                  "description": "Lowercase stable identifier"
                }
              }
            },
            "required": [
              "allowed"
            ],
            "additionalProperties": false
          },
          "reward": {
            "description": "Overrides the economy's star-based level reward",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
              "description": "Lowercase stable identifier"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tutorial": {
            "type": "object",
            "properties": {
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "trigger": {
                      "type": "string",
                      "enum": [
                        "start",
                        "first_move",
                        "first_category",
                        "first_mismatch"
                      ]
                    },
                    "textKey": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
                      "description": "Localization string key"
                    }
                  },
                  "required": [
                    "trigger",
                    "textKey"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "steps"
            ],
            "additionalProperties": false
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Mechanic-specific payload, validated by the mechanic's own schema"
          },
          "analysis": {
            "type": "object",
            "properties": {
              "solutionLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Moves in the solver's solution (perfect information)"
              },
              "solverNodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "botWinRate": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "casual",
                    "average",
                    "expert"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "generator": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "seed": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "seed"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "solutionLength",
              "solverNodes",
              "generator"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "levelId",
          "number",
          "mechanic",
          "difficulty",
          "objectives",
          "lose",
          "boosters",
          "data"
        ],
        "additionalProperties": false,
        "title": "LevelDefinition",
        "description": "One level: generic envelope plus mechanic payload"
      }
    }
  },
  "required": [
    "schemaVersion",
    "levels"
  ],
  "additionalProperties": false,
  "title": "LevelsFile",
  "description": "games/ID/levels.json (generated by gf levels generate)"
}
