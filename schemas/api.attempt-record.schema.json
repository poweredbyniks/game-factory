{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "description": "Unique per player; equals the seed"
    },
    "gameId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
      "description": "Lowercase stable identifier"
    },
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "levelId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
      "description": "Lowercase stable identifier"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "contentHash": {
      "type": "string",
      "minLength": 1,
      "description": "Selects the shipped bundle the attempt was played on"
    },
    "engineVersion": {
      "type": "string"
    },
    "mechanic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
          "description": "Lowercase stable identifier"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "moveBonus": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "remote": {
      "type": "object",
      "properties": {
        "payloadVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "experiments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "payloadVersion",
        "experiments"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "number"
    },
    "finishedAt": {
      "type": "number"
    },
    "actions": {
      "maxItems": 10000,
      "type": "array",
      "items": {}
    },
    "boostersUsed": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
        "description": "Lowercase stable identifier"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "continues": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "object",
      "properties": {
        "won": {
          "type": "boolean"
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "score": {
          "type": "number"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "won",
        "stars",
        "score",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "attemptId",
    "gameId",
    "playerId",
    "levelId",
    "attempt",
    "seed",
    "contentHash",
    "engineVersion",
    "mechanic",
    "moveBonus",
    "remote",
    "startedAt",
    "finishedAt",
    "actions",
    "boostersUsed",
    "continues",
    "outcome"
  ],
  "additionalProperties": false,
  "title": "AttemptRecord",
  "description": "POST /v1/attempts: a finished attempt the server replays"
}
