              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "emoji": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                      }
                    },
                    "required": [
                      "emoji"
                    ],
                    "additionalProperties": false
