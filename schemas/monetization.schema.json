{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Schema version of this file"
    },
    "ads": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rewarded": {
          "type": "object",
          "properties": {
            "placements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                    "description": "Lowercase stable identifier"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "continue",
                      "double_reward",
                      "free_coins",
                      "free_life"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "dailyCap": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "placements",
            "dailyCap"
          ],
          "additionalProperties": false
        },
        "interstitial": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minLevel": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "No interstitials before this level number"
            },
            "everyNLevels": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cooldownSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "minLevel",
            "everyNLevels",
            "cooldownSeconds"
          ],
          "additionalProperties": false
        },
        "banner": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "screens": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                "description": "Lowercase stable identifier"
              }
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "rewarded",
        "interstitial",
        "banner"
      ],
      "additionalProperties": false
    },
    "removeAdsEntitlement": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
      "description": "Lowercase stable identifier"
    },
    "iap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "ads",
    "removeAdsEntitlement",
    "iap"
  ],
  "additionalProperties": false,
  "title": "MonetizationDefinition",
  "description": "monetization.json: ad placements and frequency caps"
}
