{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Schema version of this file"
    },
    "unlockRule": {
      "type": "string",
      "const": "linear"
    },
    "replayCompleted": {
      "default": false,
      "type": "boolean"
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "titleKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "description": "Localization string key"
          },
          "subtitleKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "description": "Localization string key"
          },
          "levels": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "to": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "accent": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Hex color"
          },
          "unlock": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "previous_chapter"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stars"
                  },
                  "stars": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "stars"
                ],
                "additionalProperties": false
              }
            ]
          },
          "completionReward": {
            "description": "rewardTables id or an inline item bag",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                "description": "Lowercase stable identifier"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                  "description": "Lowercase stable identifier"
                },
                "additionalProperties": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "description": "Item id to positive amount"
              }
            ]
          },
          "storyIntro": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "storyOutro": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          }
        },
        "required": [
          "id",
          "titleKey",
          "levels",
          "unlock"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "unlockRule",
    "chapters"
  ],
  "additionalProperties": false,
  "title": "ProgressionDefinition",
  "description": "games/ID/progression.json: chapters and unlocks"
}
