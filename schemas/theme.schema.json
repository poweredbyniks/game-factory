            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "file": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "file"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
