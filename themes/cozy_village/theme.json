  "artDirection": {
    "styleKeywords": [
      "storybook gouache",
      "cozy autumn village",
      "hand-painted",
      "soft rounded shapes"
    ],
    "rendering": "painterly 2D with flat color blocks and soft gradients",
    "lineWork": "warm brown 2px outlines with rounded joins",
    "lighting": "late-afternoon honey light from the upper left, soft long shadows",
    "texture": "subtle watercolor paper grain",
    "perspective": "3/4 top-down for the map, front-facing for UI and portraits",
    "mood": [
      "warm",
      "homely",
      "gentle",
      "nostalgic"
    ],
    "colorNotes": "terracotta for action and roofs, sage for categories and shutters, honey for highlights, cream for paper and card faces",
    "characterStyle": "anthropomorphic woodland animals, chunky proportions, big friendly eyes, knitted and linen outfits",
    "negative": [
      "photorealism",
      "text",
      "logos",
      "watermarks",
      "harsh neon colors",
      "existing franchises or characters"
    ],
    "referenceDescriptors": [
      "vintage children's picture books",
      "autumn harvest fairs",
      "quilted textiles"
    ]
  }
