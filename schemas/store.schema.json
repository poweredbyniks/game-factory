{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Schema version of this file"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "type": {
            "type": "string",
            "enum": [
              "consumable",
              "non_consumable",
              "subscription"
            ]
          },
          "storeIds": {
            "type": "object",
            "properties": {
              "ios": {
                "type": "string"
              },
              "android": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "titleKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "description": "Localization string key"
          },
          "contents": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
              "description": "Lowercase stable identifier"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Item id to positive amount"
          },
          "entitlements": {
            "default": [],
            "description": "e.g. no_ads",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
              "description": "Lowercase stable identifier"
            }
          },
          "referencePriceUsd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Simulation and development mock only. Real prices always come from the store."
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "type",
          "storeIds",
          "titleKey",
          "referencePriceUsd"
        ],
        "additionalProperties": false
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "titleKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "description": "Localization string key"
          },
          "cost": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
              "description": "Lowercase stable identifier"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Item id to positive amount"
          },
          "contents": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
              "description": "Lowercase stable identifier"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Item id to positive amount"
          },
          "limitPerDay": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "titleKey",
          "cost",
          "contents"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "titleKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "description": "Localization string key"
          },
          "entries": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "product": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                      "description": "Lowercase stable identifier"
                    }
                  },
                  "required": [
                    "product"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "offer": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                      "description": "Lowercase stable identifier"
                    }
                  },
                  "required": [
                    "offer"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "titleKey",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    "specialOffers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "product": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "level_reached"
                  },
                  "level": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "level"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "out_of_lives"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          },
          "durationHours": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "oncePerPlayer": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "product",
          "trigger",
          "durationHours",
          "oncePerPlayer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "products",
    "offers",
    "sections"
  ],
  "additionalProperties": false,
  "title": "StoreDefinition",
  "description": "store.json: IAP products, coin offers, shop layout"
}
