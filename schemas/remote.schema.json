{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Schema version of this file"
    },
    "gameId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
      "description": "Lowercase stable identifier"
    },
    "payloadVersion": {
      "type": "string",
      "minLength": 1
    },
    "overrides": {
      "default": {},
      "type": "object",
      "properties": {
        "economy": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "monetization": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "store": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "tuning": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "experiments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
            "description": "Lowercase stable identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "paused"
            ]
          },
          "audience": {
            "type": "object",
            "properties": {
              "minLevel": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "ios",
                    "android",
                    "web",
                    "node"
                  ]
                }
              },
              "newPlayersOnly": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "variants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
                  "description": "Lowercase stable identifier"
                },
                "weight": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "overrides": {
                  "type": "object",
                  "properties": {
                    "economy": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "monetization": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "store": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "tuning": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "weight",
                "overrides"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "status",
          "variants"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "gameId",
    "payloadVersion"
  ],
  "additionalProperties": false,
  "title": "RemotePayload",
  "description": "Remote overrides and experiments, validated before activation"
}
