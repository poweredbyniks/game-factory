  "artDirection": {
    "styleKeywords": [
      "bright tropical resort",
      "clean vector illustration",
      "sunny",
      "playful"
    ],
    "rendering": "flat vector with crisp cel shading",
    "lineWork": "no outlines, shapes defined by color",
    "lighting": "high noon sun from the top right, short crisp shadows",
    "texture": "none, clean surfaces",
    "perspective": "3/4 top-down for the island map, front-facing for UI and portraits",
    "mood": [
      "sunny",
      "relaxed",
      "adventurous",
      "a little mysterious"
    ],
    "colorNotes": "lagoon teal dominates, coral for actions, sun yellow for rewards, sand for paths",
    "characterStyle": "friendly humans in resort wear, simple geometric faces, expressive poses",
    "negative": [
      "photorealism",
      "text",
      "logos",
      "watermarks",
      "dark gloomy palettes",
      "existing franchises or characters"
    ],
    "referenceDescriptors": [
